static void solve_quadratic(double a, double b, double c)
{
    printf("\n  Quadratic: (%.6g)x² + (%.6g)x + (%.6g) = 0\n", a, b, c);
    if (a == 0.0) {
        if (b == 0.0) { printf("  Not a valid equation.\n\n"); return; }
        printf("  Linear solution: x = %.8g\n\n", -c/b);
        return;
    }
    double disc = b*b - 4.0*a*c;
    if (disc > 0.0) {
        double r1 = (-b + sqrt(disc)) / (2.0*a);
        double r2 = (-b - sqrt(disc)) / (2.0*a);
        printf("  Two real roots:\n    x₁ = %.10g\n    x₂ = %.10g\n\n", r1, r2);
    } else if (disc == 0.0) {
        printf("  One repeated root:\n    x = %.10g\n\n", -b/(2.0*a));
    } else {
        double re = -b/(2.0*a);
        double im =  sqrt(-disc)/(2.0*a);
        printf("  Two complex roots:\n    x₁ = %.8g + %.8gi\n    x₂ = %.8g - %.8gi\n\n",
               re, im, re, im);
    }
}

static int is_prime(long long n)
{
    if (n < 2)  return 0;
    if (n == 2) return 1;
    if (n % 2 == 0) return 0;
    for (long long i = 3; i * i <= n; i += 2)
        if (n % i == 0) return 0;
    return 1;
}

static void print_primes_up_to(long long limit)
{
    printf("  Primes up to %lld:\n  ", limit);
    int count = 0;
    for (long long i = 2; i <= limit; i++) {
        if (is_prime(i)) { printf("%lld ", i); count++; }
    }
    printf("\n  Total: %d primes\n\n", count);
}

static void base_convert(long long n, int base)
{
    if (base < 2 || base > 16) { printf("  Base must be 2–16.\n\n"); return; }
    char digits[] = "0123456789ABCDEF";
    char buf[128]; int idx = 0;
    long long nn = (n < 0) ? -n : n;
    if (nn == 0) { printf("  Base %d: 0\n\n", base); return; }
    while (nn > 0) { buf[idx++] = digits[nn % base]; nn /= base; }
    if (n < 0) buf[idx++] = '-';
    printf("  Decimal %lld  →  Base-%d: ", n, base);
    for (int i = idx-1; i >= 0; i--) putchar(buf[i]);
    printf("\n\n");
}

static void extras_mode(void)
{
    char buf[256];
    printf("\n  ══ Extras Mode ══  (:done to return)\n");
    printf("  Commands:\n");
    printf("    quad <a> <b> <c>       — solve ax²+bx+c=0\n");
    printf("    prime <n>              — test if n is prime\n");
    printf("    primes <limit>         — list primes up to limit\n");
    printf("    gcd <a> <b>            — greatest common divisor\n");
    printf("    lcm <a> <b>            — least common multiple\n");
    printf("    base <n> <base>        — convert decimal n to given base\n\n");
    while (1) {
        printf("  extras> "); fflush(stdout);
        if (!fgets(buf,sizeof(buf),stdin)) break;
        buf[strcspn(buf,"\n")] = '\0';
        if (!strcmp(buf,":done")||!strcmp(buf,":q")) break;

        double a,b,c;
        long long ia, ib;
        if (!strncmp(buf,"quad ",5) && sscanf(buf+5,"%lf %lf %lf",&a,&b,&c)==3) {
            solve_quadratic(a,b,c);
        } else if (!strncmp(buf,"prime ",6)) {
            long long n = atoll(buf+6);
            printf("  %lld is %s prime.\n\n", n, is_prime(n)?"":"NOT ");
        } else if (!strncmp(buf,"primes ",7)) {
            long long lim = atoll(buf+7);
            if(lim>100000){printf("  Limit too large (max 100000).\n\n");continue;}
            print_primes_up_to(lim);
        } else if (!strncmp(buf,"gcd ",4) && sscanf(buf+4,"%lld %lld",&ia,&ib)==2) {
            printf("  gcd(%lld, %lld) = %.0f\n\n", ia, ib, gcd_d((double)ia,(double)ib));
        } else if (!strncmp(buf,"lcm ",4) && sscanf(buf+4,"%lld %lld",&ia,&ib)==2) {
            double g = gcd_d((double)ia,(double)ib);
            double l = (g==0)?0:fabs((double)(ia*ib))/g;
            printf("  lcm(%lld, %lld) = %.0f\n\n", ia, ib, l);
        } else if (!strncmp(buf,"base ",5)) {
            long long n; int base;
            if(sscanf(buf+5,"%lld %d",&n,&base)==2) base_convert(n,base);
            else printf("  Usage: base <decimal_n> <target_base>\n");
        } else {
            printf("  Unknown command.\n");
        }
    }
}

