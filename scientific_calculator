 * ───────────────────────────────────────────────────────────────────────────── */

/* Convert angle from current mode to radians (for trig input) */
static double to_rad(double a)
{
    switch (g_mode) {
        case MODE_DEG:  return a * CALC_PI / 180.0;
        case MODE_GRAD: return a * CALC_PI / 200.0;
        default:        return a;
    }
}

/* Convert radians back to current mode (for inverse trig output) */
static double from_rad(double r)
{
    switch (g_mode) {
        case MODE_DEG:  return r * 180.0 / CALC_PI;
        case MODE_GRAD: return r * 200.0 / CALC_PI;
        default:        return r;
    }
}

/* ─────────────────────────────────────────────────────────────────────────────
