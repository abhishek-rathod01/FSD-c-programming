static const char *err_msg(CalcError e)
{
    switch (e) {
        case ERR_DIV_ZERO: return "Error: Division by zero";
        case ERR_DOMAIN:   return "Error: Domain error (invalid input for function)";
        case ERR_SYNTAX:   return "Error: Syntax error in expression";
        case ERR_OVERFLOW: return "Error: Numeric overflow";
        case ERR_UNDEF:    return "Error: Undefined function or variable";
        default:           return "Error: Unknown error";
    }
}

