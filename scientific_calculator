static double safe_sqrt(double x)
{
    if (x < 0.0) { set_err(ERR_DOMAIN); return 0.0; }
    return sqrt(x);
}

static double safe_log(double x)
{
    if (x <= 0.0) { set_err(ERR_DOMAIN); return 0.0; }
    return log(x);
}

static double safe_log10(double x)
{
    if (x <= 0.0) { set_err(ERR_DOMAIN); return 0.0; }
    return log10(x);
}

static double safe_log2(double x)
{
    if (x <= 0.0) { set_err(ERR_DOMAIN); return 0.0; }
    return log2(x);
}

static double safe_asin(double x)
{
    if (x < -1.0 || x > 1.0) { set_err(ERR_DOMAIN); return 0.0; }
    return asin(x);
}

static double safe_acos(double x)
{
    if (x < -1.0 || x > 1.0) { set_err(ERR_DOMAIN); return 0.0; }
    return acos(x);
}

static double safe_acosh(double x)
{
    if (x < 1.0) { set_err(ERR_DOMAIN); return 0.0; }
    return acosh(x);
}

static double safe_atanh(double x)
{
    if (x <= -1.0 || x >= 1.0) { set_err(ERR_DOMAIN); return 0.0; }
    return atanh(x);
}

static double safe_tan(double x)
{
    double r = to_rad(x);
    double c = cos(r);
    if (fabs(c) < 1e-15) { set_err(ERR_DOMAIN); return 0.0; }
    return sin(r) / c;
}

static double factorial(double n)
{
    if (n < 0.0 || n != floor(n)) { set_err(ERR_DOMAIN); return 0.0; }
    if (n > 170.0) { set_err(ERR_OVERFLOW); return 0.0; }
    double r = 1.0;
    for (int i = 2; i <= (int)n; i++) r *= i;
    return r;
}

static double gcd_d(double a, double b)
{
    a = fabs(a); b = fabs(b);
    while (b > 1e-9) { double t = fmod(a, b); a = b; b = t; }
    return a;
}

