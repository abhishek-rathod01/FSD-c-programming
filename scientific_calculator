typedef struct { const char *sym; double to_base; } UnitRow;

static void conv_length(double val, const char *from, const char *to)
{
    static UnitRow tbl[] = {
        {"m",0.01},{"km",10.0},{"cm",0.0001},{"mm",0.00001},
        {"in",0.000254},{"ft",0.003048},{"yd",0.009144},
        {"mi",16.09344},{"nm",18.52},{"um",0.00000001},{NULL,0}
    };
    /* base unit = 1 cm */
    double ff=0, tf=0;
    for(int i=0;tbl[i].sym;i++){
        if(!strcmp(tbl[i].sym,from)) ff=tbl[i].to_base;
        if(!strcmp(tbl[i].sym,to))   tf=tbl[i].to_base;
    }
    if(!ff||!tf){printf("  Unknown unit (try m km cm mm in ft yd mi nm um).\n\n");return;}
    printf("  %.8g %s = %.8g %s\n\n", val, from, val*ff/tf, to);
}

static void conv_weight(double val, const char *from, const char *to)
{
    static UnitRow tbl[] = {
        {"kg",1.0},{"g",0.001},{"mg",0.000001},
        {"lb",0.45359237},{"oz",0.02834952},{"t",1000.0},{NULL,0}
    };
    double ff=0,tf=0;
    for(int i=0;tbl[i].sym;i++){
        if(!strcmp(tbl[i].sym,from)) ff=tbl[i].to_base;
        if(!strcmp(tbl[i].sym,to))   tf=tbl[i].to_base;
    }
    if(!ff||!tf){printf("  Unknown unit (try kg g mg lb oz t).\n\n");return;}
    printf("  %.8g %s = %.8g %s\n\n", val, from, val*ff/tf, to);
}

static void conv_temp(double val, char from, char to)
{
    double c;
    switch(from){
        case 'C':c=val;break;
        case 'F':c=(val-32.0)*5.0/9.0;break;
        case 'K':c=val-273.15;break;
        default:printf("  Unknown unit (C F K).\n\n");return;
    }
    double r;
    switch(to){
        case 'C':r=c;break;
        case 'F':r=c*9.0/5.0+32.0;break;
        case 'K':r=c+273.15;break;
        default:printf("  Unknown unit (C F K).\n\n");return;
    }
    printf("  %.6g°%c = %.6g°%c\n\n", val, from, r, to);
}

static void conv_mode(void)
{
    char buf[256];
    printf("\n  ══ Unit Conversion Mode ══  (:done to return)\n");
    printf("  Commands:\n");
    printf("    len  <val> <from> <to>   e.g.  len 5 km m\n");
    printf("    mass <val> <from> <to>   e.g.  mass 70 kg lb\n");
    printf("    temp <val> <from> <to>   e.g.  temp 100 C F   (units: C F K)\n\n");
    while (1) {
        printf("  conv> "); fflush(stdout);
