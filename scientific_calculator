    return 0.0;
}

/* ─────────────────────────────────────────────────────────────────────────────
 *  SECTION 8 — RECURSIVE-DESCENT EXPRESSION PARSER
 *
 *  Grammar (highest precedence last in call chain → deepest recursion first):
 *
 *    expr     = term   { ('+' | '-')  term   }
 *    term     = factor { ('*' | '/' | '%') factor }
 *    factor   = unary  { '^' factor }          (right-associative)
 *    unary    = '-' primary | '+' primary | primary
 *    primary  = number | '(' expr ')' | ident [ '(' expr ')' ]
 *
 * ───────────────────────────────────────────────────────────────────────────── */

/* Forward declarations */
static double parse_expr(const char **p);
static double parse_term(const char **p);
static double parse_factor(const char **p);
static double parse_unary(const char **p);
static double parse_primary(const char **p);

static void skip_ws(const char **p)
{
    while (**p == ' ' || **p == '\t') (*p)++;
}

static double parse_number(const char **p)
{
    skip_ws(p);
    char *end;
    errno = 0;
    double v = strtod(*p, &end);
    if (end == *p) { set_err(ERR_SYNTAX); return 0.0; }
    *p = end;
    if (errno == ERANGE) set_err(ERR_OVERFLOW);
    return v;
}

/* Read alphabetic identifier into buf; returns length */
static int read_ident(const char **p, char *buf, int max)
{
    skip_ws(p);
    int n = 0;
    while ((isalpha((unsigned char)**p) || **p == '_') && n < max - 1)
        buf[n++] = *(*p)++;
    buf[n] = '\0';
    return n;
}

static double parse_primary(const char **p)
{
    skip_ws(p);

    /* Parenthesised expression */
    if (**p == '(') {
        (*p)++;
        double v = parse_expr(p);
        skip_ws(p);
        if (**p != ')') { set_err(ERR_SYNTAX); return 0.0; }
        (*p)++;
        return v;
    }

    /* Numeric literal */
    if (isdigit((unsigned char)**p) || **p == '.') return parse_number(p);

    /* Identifier: constant, memory slot, or function */
    if (isalpha((unsigned char)**p) || **p == '_') {
        char name[64];
        read_ident(p, name, sizeof(name));
        skip_ws(p);

        /* ── Named constants ── */
        if (!strcmp(name,"pi")  || !strcmp(name,"PI"))   return CALC_PI;
        if (!strcmp(name,"e"))                             return CALC_E;
        if (!strcmp(name,"phi"))                           return CALC_PHI;
        if (!strcmp(name,"sqrt2"))                         return CALC_SQRT2;
        if (!strcmp(name,"ln2"))                           return CALC_LN2;
        if (!strcmp(name,"ans"))                           return g_ans;
        if (!strcmp(name,"inf"))                           return HUGE_VAL;

        /* ── Memory slots: mem0 … mem9 ── */
        if (!strncmp(name,"mem",3) && isdigit((unsigned char)name[3]) && !name[4]) {
            int idx = name[3] - '0';
            return g_mem[idx];
        }

        /* ── Function call: name(arg) ── */
        if (**p == '(') {
            (*p)++;
            double arg = parse_expr(p);
            skip_ws(p);
            if (**p != ')') { set_err(ERR_SYNTAX); return 0.0; }
            (*p)++;
            return call_fn(name, arg);
        }

        set_err(ERR_UNDEF);
        return 0.0;
    }

    set_err(ERR_SYNTAX);
    return 0.0;
}

static double parse_unary(const char **p)
{
    skip_ws(p);
    if (**p == '-') { (*p)++; return -parse_unary(p); }
    if (**p == '+') { (*p)++; return  parse_unary(p); }
    return parse_primary(p);
}

static double parse_factor(const char **p)
{
    double base = parse_unary(p);
    skip_ws(p);

    /* Postfix factorial:  expr! */
    if (**p == '!') { (*p)++; return factorial(base); }

    /* Right-associative exponentiation: a^b^c = a^(b^c) */
    if (**p == '^') {
        (*p)++;
        double exponent = parse_factor(p);   /* recurse for right-assoc */
        if (base < 0.0 && exponent != floor(exponent))
            { set_err(ERR_DOMAIN); return 0.0; }
        return pow(base, exponent);
    }
    return base;
}

static double parse_term(const char **p)
{
    double left = parse_factor(p);
    skip_ws(p);
    while (**p == '*' || **p == '/' || **p == '%') {
        char op = *(*p)++;
        double right = parse_factor(p);
        if (op == '*') {
            left *= right;
        } else {
            if (right == 0.0) { set_err(ERR_DIV_ZERO); return 0.0; }
            left = (op == '/') ? left / right : fmod(left, right);
        }
        skip_ws(p);
    }
    return left;
}

static double parse_expr(const char **p)
{
    double left = parse_term(p);
    skip_ws(p);
    while (**p == '+' || **p == '-') {
        char op = *(*p)++;
        double right = parse_term(p);
        left = (op == '+') ? left + right : left - right;
        skip_ws(p);
    }
    return left;
}

/* Top-level evaluate — returns result; check g_error after call */
static double evaluate(const char *expr)
{
    g_error = ERR_NONE;
    const char *p = expr;
    skip_ws(&p);
    if (*p == '\0') return g_ans;
    double result = parse_expr(&p);
    skip_ws(&p);
    if (*p != '\0' && g_error == ERR_NONE) set_err(ERR_SYNTAX);
    return result;
}

/* ─────────────────────────────────────────────────────────────────────────────
 *  SECTION 9 — HISTORY
 * ───────────────────────────────────────────────────────────────────────────── */

static void hist_add(const char *expr, double result)
{
    if (g_hist_n == MAX_HIST)
        memmove(g_history, g_history + 1, (MAX_HIST-1) * sizeof(HistEntry));
    else
        g_hist_n++;
    strncpy(g_history[g_hist_n-1].expr, expr, MAX_EXPR-1);
    g_history[g_hist_n-1].result = result;
}

static void hist_print(void)
{
    if (!g_hist_n) { printf("  (no history)\n\n"); return; }
    printf("\n  %-3s  %-42s  %s\n", "#", "Expression", "Result");
    printf("  %s\n", "───────────────────────────────────────────────────────");
    for (int i = 0; i < g_hist_n; i++)
        printf("  %-3d  %-42s  %.12g\n",
               i + 1, g_history[i].expr, g_history[i].result);
    printf("\n");
}

