}

/* ─────────────────────────────────────────────────────────────────────────────
 *  SECTION 11 — STATISTICS MODULE
 * ───────────────────────────────────────────────────────────────────────────── */

static int cmp_dbl(const void *a, const void *b)
{
    double da = *(double*)a, db = *(double*)b;
    return (da > db) - (da < db);
}

static void stat_compute(void)
{
    if (!g_data_n) { printf("  No data yet. Use  add <value>\n\n"); return; }

    double sum = 0.0;
    for (int i = 0; i < g_data_n; i++) sum += g_data[i];
    double mean = sum / g_data_n;

    double var_sum = 0.0;
    for (int i = 0; i < g_data_n; i++) {
        double d = g_data[i] - mean;
        var_sum += d * d;
    }
    double pop_var  = var_sum / g_data_n;
    double samp_var = (g_data_n > 1) ? var_sum / (g_data_n - 1) : 0.0;

    double sorted[MAX_DATA];
    memcpy(sorted, g_data, g_data_n * sizeof(double));
    qsort(sorted, g_data_n, sizeof(double), cmp_dbl);

    double median = (g_data_n % 2 == 0)
        ? (sorted[g_data_n/2-1] + sorted[g_data_n/2]) / 2.0
        : sorted[g_data_n / 2];

    double ss = 0.0;
    for (int i = 0; i < g_data_n; i++) ss += g_data[i] * g_data[i];

    double geo = 0.0;
    int geo_ok = 1;
    for (int i = 0; i < g_data_n; i++) {
        if (g_data[i] <= 0.0) { geo_ok = 0; break; }
        geo += log(g_data[i]);
    }
    if (geo_ok) geo = exp(geo / g_data_n);

    printf("\n  ╔═══════════════════════════════════════╗\n");
    printf("  ║       Statistical Summary             ║\n");
    printf("  ╠═══════════════════════════════════════╣\n");
    printf("  ║  Count            : %-18d║\n", g_data_n);
    printf("  ║  Sum              : %-18.8g║\n", sum);
    printf("  ║  Mean (μ)         : %-18.8g║\n", mean);
    printf("  ║  Median           : %-18.8g║\n", median);
    printf("  ║  Min              : %-18.8g║\n", sorted[0]);
    printf("  ║  Max              : %-18.8g║\n", sorted[g_data_n-1]);
    printf("  ║  Range            : %-18.8g║\n", sorted[g_data_n-1] - sorted[0]);
    printf("  ║  Pop. Variance    : %-18.8g║\n", pop_var);
    printf("  ║  Pop. Std Dev (σ) : %-18.8g║\n", sqrt(pop_var));
    printf("  ║  Samp. Variance   : %-18.8g║\n", samp_var);
    printf("  ║  Samp. Std Dev(s) : %-18.8g║\n", sqrt(samp_var));
    printf("  ║  Sum of Squares   : %-18.8g║\n", ss);
    if (geo_ok)
    printf("  ║  Geometric Mean   : %-18.8g║\n", geo);
    printf("  ╚═══════════════════════════════════════╝\n\n");
}

static void stat_mode(void)
{
    char buf[256];
    printf("\n  ══ Statistics Mode ══  (:done to return)\n");
    printf("  Commands:  add <val>  |  clear  |  list  |  compute\n\n");
    while (1) {
        printf("  stat> "); fflush(stdout);
        if (!fgets(buf, sizeof(buf), stdin)) break;
        buf[strcspn(buf, "\n")] = '\0';
        if (!strcmp(buf,":done")||!strcmp(buf,":q")) break;

        if (!strncmp(buf,"add ",4)) {
            if (g_data_n >= MAX_DATA) { printf("  Buffer full (%d).\n", MAX_DATA); continue; }
            g_data[g_data_n++] = atof(buf+4);
            printf("  Added %.8g  (n = %d)\n", g_data[g_data_n-1], g_data_n);
        } else if (!strcmp(buf,"clear")) {
            g_data_n = 0; printf("  Data cleared.\n");
        } else if (!strcmp(buf,"list")) {
            printf("  Data:");
            for (int i = 0; i < g_data_n; i++) printf(" %.6g", g_data[i]);
            printf("\n");
        } else if (!strcmp(buf,"compute")) {
            stat_compute();
        } else {
            printf("  Unknown. Use: add <val> | clear | list | compute\n");
        }
    }
}

/* ─────────────────────────────────────────────────────────────────────────────
 *  SECTION 12 — MATRIX MODULE (up to 3×3)
 * ───────────────────────────────────────────────────────────────────────────── */

typedef struct { double m[3][3]; int r, c; } Matrix;

static void mat_print(const Matrix *M, const char *lbl)
{
    printf("  %s (%d×%d):\n", lbl, M->r, M->c);
    for (int i = 0; i < M->r; i++) {
        printf("    [");
        for (int j = 0; j < M->c; j++) printf(" %10.4f", M->m[i][j]);
        printf("  ]\n");
    }
}

static Matrix mat_add(const Matrix *A, const Matrix *B)
{
    Matrix C = *A;
    for (int i=0;i<A->r;i++) for(int j=0;j<A->c;j++) C.m[i][j]=A->m[i][j]+B->m[i][j];
    return C;
}

static Matrix mat_sub(const Matrix *A, const Matrix *B)
{
    Matrix C = *A;
    for (int i=0;i<A->r;i++) for(int j=0;j<A->c;j++) C.m[i][j]=A->m[i][j]-B->m[i][j];
    return C;
}

static Matrix mat_mul(const Matrix *A, const Matrix *B)
{
    Matrix C; memset(&C,0,sizeof(C)); C.r=A->r; C.c=B->c;
    for (int i=0;i<A->r;i++) for(int j=0;j<B->c;j++) for(int k=0;k<A->c;k++)
        C.m[i][j] += A->m[i][k] * B->m[k][j];
    return C;
}

static Matrix mat_trans(const Matrix *A)
{
    Matrix T; T.r=A->c; T.c=A->r;
    for(int i=0;i<A->r;i++) for(int j=0;j<A->c;j++) T.m[j][i]=A->m[i][j];
    return T;
}

static double mat_det2(const Matrix *A)
{ return A->m[0][0]*A->m[1][1] - A->m[0][1]*A->m[1][0]; }

static double mat_det3(const Matrix *A)
{
    return A->m[0][0]*(A->m[1][1]*A->m[2][2]-A->m[1][2]*A->m[2][1])
          -A->m[0][1]*(A->m[1][0]*A->m[2][2]-A->m[1][2]*A->m[2][0])
          +A->m[0][2]*(A->m[1][0]*A->m[2][1]-A->m[1][1]*A->m[2][0]);
}

static int mat_input(Matrix *M, const char *lbl)
{
    char buf[256];
    printf("  %s — size (2 or 3)? ", lbl);
    if (!fgets(buf,sizeof(buf),stdin)) return 0;
    int n = atoi(buf);
    if (n<2||n>3) { printf("  Must be 2 or 3.\n"); return 0; }
    M->r = M->c = n;
    printf("  Enter %d rows, each with %d space-separated values:\n", n, n);
    for (int i = 0; i < n; i++) {
        printf("    Row %d: ", i+1);
        if (!fgets(buf,sizeof(buf),stdin)) return 0;
        char *tok = strtok(buf," \t\n");
        for (int j=0; j<n && tok; j++, tok=strtok(NULL," \t\n"))
            M->m[i][j] = atof(tok);
    }
    return 1;
}

static void matrix_mode(void)
{
    char buf[256];
    Matrix A, B, C;
    memset(&A,0,sizeof(A)); memset(&B,0,sizeof(B));
    printf("\n  ══ Matrix Mode ══  (:done to return)\n");
    printf("  Commands: input A | input B | add | sub | mul | trans A | trans B |\n");
    printf("            det A | det B\n\n");
    while (1) {
        printf("  mat> "); fflush(stdout);
        if (!fgets(buf,sizeof(buf),stdin)) break;
        buf[strcspn(buf,"\n")] = '\0';
        if (!strcmp(buf,":done")||!strcmp(buf,":q")) break;

        if (!strcmp(buf,"input A")) { if(mat_input(&A,"Matrix A")) mat_print(&A,"A"); }
        else if (!strcmp(buf,"input B")) { if(mat_input(&B,"Matrix B")) mat_print(&B,"B"); }
        else if (!strcmp(buf,"add")) {
            if(A.r!=B.r||A.c!=B.c){printf("  Dimension mismatch.\n");continue;}
            C=mat_add(&A,&B); mat_print(&C,"A + B");
        } else if (!strcmp(buf,"sub")) {
            if(A.r!=B.r||A.c!=B.c){printf("  Dimension mismatch.\n");continue;}
            C=mat_sub(&A,&B); mat_print(&C,"A - B");
        } else if (!strcmp(buf,"mul")) {
            if(A.c!=B.r){printf("  Dimension mismatch (A.cols must = B.rows).\n");continue;}
            C=mat_mul(&A,&B); mat_print(&C,"A × B");
        } else if (!strcmp(buf,"trans A")) { C=mat_trans(&A); mat_print(&C,"Aᵀ"); }
        else if (!strcmp(buf,"trans B")) { C=mat_trans(&B); mat_print(&C,"Bᵀ"); }
        else if (!strcmp(buf,"det A")) {
            double d=(A.r==2)?mat_det2(&A):mat_det3(&A);
            printf("  det(A) = %.8g\n\n", d);
        } else if (!strcmp(buf,"det B")) {
            double d=(B.r==2)?mat_det2(&B):mat_det3(&B);
            printf("  det(B) = %.8g\n\n", d);
        } else { printf("  Unknown command.\n"); }
    }
}

