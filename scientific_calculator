        char u1[16],u2[16]; double val;
        if (!strncmp(buf,"len ",4) && sscanf(buf+4,"%lf %15s %15s",&val,u1,u2)==3)
            conv_length(val,u1,u2);
        else if (!strncmp(buf,"mass ",5) && sscanf(buf+5,"%lf %15s %15s",&val,u1,u2)==3)
            conv_weight(val,u1,u2);
        else if (!strncmp(buf,"temp ",5) && sscanf(buf+5,"%lf %15s %15s",&val,u1,u2)==3)
            conv_temp(val,u1[0],u2[0]);
        else printf("  Usage: len <v> <u> <u>  |  mass <v> <u> <u>  |  temp <v> <u> <u>\n");
    }
}

