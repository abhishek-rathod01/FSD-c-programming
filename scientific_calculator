/* Returns 0 → continue, -1 → quit */
static int handle_cmd(const char *cmd)
{
    if (!strcmp(cmd,":quit")||!strcmp(cmd,":q"))    return -1;
    if (!strcmp(cmd,":help")||!strcmp(cmd,":h"))    { print_help();     return 0; }
    if (!strcmp(cmd,":deg"))                        { g_mode=MODE_DEG;  printf("  Mode: DEG\n\n"); return 0; }
    if (!strcmp(cmd,":rad"))                        { g_mode=MODE_RAD;  printf("  Mode: RAD\n\n"); return 0; }
    if (!strcmp(cmd,":grad"))                       { g_mode=MODE_GRAD; printf("  Mode: GRAD\n\n");return 0; }
    if (!strcmp(cmd,":mode"))                       { printf("  Angle mode: %s\n\n",mode_str()); return 0; }
    if (!strcmp(cmd,":hist"))                       { hist_print();     return 0; }
    if (!strcmp(cmd,":clrhist"))                    { g_hist_n=0; printf("  History cleared.\n\n"); return 0; }
    if (!strcmp(cmd,":const"))                      { print_constants();return 0; }
    if (!strcmp(cmd,":mlist"))                      { mem_list();       return 0; }
    if (!strcmp(cmd,":stat"))                       { stat_mode();      return 0; }
    if (!strcmp(cmd,":matrix"))                     { matrix_mode();    return 0; }
    if (!strcmp(cmd,":conv"))                       { conv_mode();      return 0; }
    if (!strcmp(cmd,":extras"))                     { extras_mode();    return 0; }

    int slot;
    if (!strncmp(cmd,":ms ",4)&&sscanf(cmd+4,"%d",&slot)==1) { mem_store(slot,g_ans);    return 0; }
    if (!strncmp(cmd,":mr ",4)&&sscanf(cmd+4,"%d",&slot)==1) { mem_recall(slot);         return 0; }
    if (!strncmp(cmd,":ma ",4)&&sscanf(cmd+4,"%d",&slot)==1) { mem_add_slot(slot,g_ans); return 0; }
    if (!strncmp(cmd,":mc ",4)&&sscanf(cmd+4,"%d",&slot)==1) { mem_clear(slot);          return 0; }

    printf("  Unknown command: %s   (try :help)\n\n", cmd);
    return 0;
}

/* ─────────────────────────────────────────────────────────────────────────────
 *  SECTION 17 — MAIN LOOP
 * ───────────────────────────────────────────────────────────────────────────── */

int main(void)
{
    char line[MAX_EXPR];
    memset(g_mem, 0, sizeof(g_mem));

    print_banner();
    printf("  [%s] ", mode_str()); fflush(stdout);

    while (fgets(line, sizeof(line), stdin)) {
        /* Strip trailing newline / CR */
        line[strcspn(line, "\r\n")] = '\0';

        /* Skip blank lines */
        if (line[0] == '\0') {
            printf("  [%s] ", mode_str()); fflush(stdout);
            continue;
        }

        /* Command path */
        if (line[0] == ':') {
            if (handle_cmd(line) == -1) break;
            printf("  [%s] ", mode_str()); fflush(stdout);
            continue;
        }

        /* Expression path */
        double result = evaluate(line);
        if (g_error == ERR_NONE) {
            g_ans = result;
            hist_add(line, result);
        }
        print_result(result);
        printf("  [%s] ", mode_str()); fflush(stdout);
    }

    printf("\n  Goodbye!\n\n");
    return 0;
}

